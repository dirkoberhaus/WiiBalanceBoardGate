# Classic Bluetooth (BR/EDR) HID host, to connect to the Wii Balance Board.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_L2CAP_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y

# We don't need BLE at all; keep it out to save RAM.
CONFIG_BT_BLE_ENABLED=n
# The BLE/BR-EDR/dual-mode choice defaults to BLE-only regardless of the
# option above and must be set separately, or esp_bt_controller_enable()
# rejects ESP_BT_MODE_CLASSIC_BT with ESP_ERR_INVALID_ARG.
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y

# WebSocket support for the HTTP server, used to stream samples.
CONFIG_HTTPD_WS_SUPPORT=y

# BT + WiFi don't fit the default 1MB app partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Matches the common 4MB flash size on ESP32 dev boards; change if yours differs.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# OTA updates (see src/ota.c): the bootloader boots a freshly-flashed image
# as "pending verify" and only keeps it if the app explicitly confirms
# itself - esp_ota_mark_app_valid_cancel_rollback() in main.c. If a bad
# image crashes/reboot-loops before reaching that call, the bootloader
# automatically reverts to the previous working slot instead of bricking
# the board.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
