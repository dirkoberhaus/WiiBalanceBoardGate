# Classic Bluetooth (BR/EDR) HID host, to connect to the Wii Balance Board.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_L2CAP_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y

# We don't need BLE at all; keep it out to save RAM.
CONFIG_BT_BLE_ENABLED=n

# WebSocket support for the HTTP server, used to stream samples.
CONFIG_HTTPD_WS_SUPPORT=y

# BT + WiFi don't fit the default 1MB app partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Matches the common 4MB flash size on ESP32 dev boards; change if yours differs.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
